#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")/.."

rm -rf dist
pnpm exec tsc -p tsconfig.build.json

cp src/commands/scorecard-blank-template.yaml dist/commands/
cp src/commands/catalog/entity-type-blank-template.yaml dist/commands/catalog/

cp node_modules/tree-sitter-python/tree-sitter-python.wasm dist/
cp node_modules/tree-sitter-typescript/tree-sitter-tsx.wasm dist/
